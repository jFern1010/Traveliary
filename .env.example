# Copy to .env.local and fill in from Supabase dashboard → Project Settings → API Keys.
# The publishable key (sb_publishable_...) is safe to ship in the app; a legacy "anon" key also works.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
